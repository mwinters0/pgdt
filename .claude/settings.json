{
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.29"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.29"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/contained.py\" --hook",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/scratchpad-end.sh\"",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  }
}
